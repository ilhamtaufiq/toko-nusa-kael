# Salin menjadi .env lalu isi. Jangan commit file .env.

# Kata sandi panel admin (/admin), minimal 8 karakter
ADMIN_PASSWORD=

# Midtrans untuk QRIS (kosongkan jika belum dipakai)
# Mulai dari sandbox: https://api.sandbox.midtrans.com. Ganti ke https://api.midtrans.com saat produksi.
MIDTRANS_SERVER_KEY=
MIDTRANS_API_BASE=https://api.sandbox.midtrans.com

# Gateway GoPay (QRIS). Rahasia antar-service, minimal 32 karakter. Buat acak, misalnya: openssl rand -hex 32
GATEWAY_SECRET=

# Database MySQL (dipakai docker compose)
DB_NAME=nusa_kael
DB_USER=nusa
DB_PASSWORD=
DB_ROOT_PASSWORD=
