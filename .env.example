# Salin menjadi .env lalu isi. Jangan commit file .env.

# Kata sandi panel admin (/admin), minimal 8 karakter
ADMIN_PASSWORD=

# Gateway pemantau QRIS GoBiz. Rahasia antar-service, minimal 32 karakter. Buat acak, misalnya: openssl rand -hex 32
GATEWAY_SECRET=

# Login GoBiz untuk memantau QRIS. Kata sandi login diatur dulu di portal GoFood Merchant (halaman profil).
GOPAY_EMAIL=
GOPAY_PASSWORD=

# Database MySQL (dipakai docker compose)
DB_NAME=nusa_kael
DB_USER=nusa
DB_PASSWORD=
DB_ROOT_PASSWORD=
